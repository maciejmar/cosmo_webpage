# Copy to .env and fill in. Never commit .env.

PORT=3001
HOST=127.0.0.1

# Long random string (min. 32 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Where content JSON, users and uploaded images are stored (kept between deploys).
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Max size of a single uploaded image in MB.
MAX_UPLOAD_MB=8

SITE_URL=https://cosmopolish.mathe.pl

# E-mail alert on every admin login from an IP the account has not used before.
# Leave SMTP_HOST or ALERT_EMAIL_TO empty to disable. The deploy workflow fills these from GitHub Secrets.
# SMTP_SECURE=true for port 465 (SSL), false for 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Comma-separated list of recipients.
ALERT_EMAIL_TO=

# Optional: creates the first admin on startup if no admin exists yet.
# Remove these after the first start - prefer `npm run create-admin`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
